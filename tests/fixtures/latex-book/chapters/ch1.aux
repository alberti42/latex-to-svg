\relax 
\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {chapter}{\numberline {1}One}{1}{chapter.1}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{ch:one}{{1}{1}{One}{chapter.1}{}}
\newlabel{ch:one@cref}{{[chapter][1][]1}{[1][1][]1}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1.1}S}{1}{section.1.1}\protected@file@percent }
\newlabel{sec:s}{{1.1}{1}{S}{section.1.1}{}}
\newlabel{sec:s@cref}{{[section][1][1]1.1}{[1][1][]1}{}{}{}}
\newlabel{eq:x}{{1.1}{1}{S}{equation.1.1}{}}
\newlabel{eq:x@cref}{{[equation][1][1]1.1}{[1][1][]1}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces C}}{1}{figure.1.1}\protected@file@percent }
\newlabel{fig:c}{{1.1}{1}{C}{figure.1.1}{}}
\newlabel{fig:c@cref}{{[figure][1][1]1.1}{[1][1][]1}{}{}{}}
\@setckpt{chapters/ch1}{
\setcounter{page}{2}
\setcounter{equation}{1}
\setcounter{enumi}{0}
\setcounter{enumii}{0}
\setcounter{enumiii}{0}
\setcounter{enumiv}{0}
\setcounter{footnote}{0}
\setcounter{mpfootnote}{0}
\setcounter{part}{0}
\setcounter{chapter}{1}
\setcounter{section}{1}
\setcounter{subsection}{0}
\setcounter{subsubsection}{0}
\setcounter{paragraph}{0}
\setcounter{subparagraph}{0}
\setcounter{figure}{1}
\setcounter{table}{0}
\setcounter{parentequation}{0}
\setcounter{section@level}{1}
\setcounter{Item}{0}
\setcounter{Hfootnote}{0}
\setcounter{bookmark@seq@number}{2}
}
